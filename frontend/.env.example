# ===========================
# بصيرة (Baseerah) frontend -- environment variables
# ===========================
# Copy to .env.local and adjust. Never commit .env.local -- .gitignore
# already excludes every .env* file.
#
# Every variable here MUST be safe to ship inside the public JavaScript
# bundle: Next.js inlines any `NEXT_PUBLIC_*` variable into client code
# at build time, so nothing prefixed `NEXT_PUBLIC_` may ever hold a
# secret, API key, or credential. There is currently no non-public
# (server-only) env var this frontend reads -- it never talks to
# SAHMK/OpenAI/the database directly, only to the backend API, which is
# the one place those credentials live (see ../.env.example).

# Backend API base URL. The frontend's `apiFetch` wrapper
# (src/lib/api/client.ts) prefixes every request with this.
NEXT_PUBLIC_API_BASE_URL=http://localhost:8000

# This frontend's own canonical URL -- used for building absolute links
# (e.g. in emails, redirect validation). Not yet read by any code path;
# reserved for the staging/production deployment milestone.
# NEXT_PUBLIC_APP_URL=https://app.baseerah.sa
