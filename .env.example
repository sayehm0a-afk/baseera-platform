# ===========================
# منصة بصيرة (Baseerah) - متغيرات البيئة
# ===========================
# انسخ هذا الملف إلى .env وعدّل القيم المناسبة.
# لا ترفع ملف .env إلى Git أبداً -- .gitignore يستثنيه تلقائياً.
#
# This file lists every variable name Settings/os.getenv reads for
# connectivity, security, and third-party credentials. It intentionally
# does NOT duplicate the ~60 pure business-logic tuning knobs each
# subsystem's own config.py defines (backtest limits, market-scan
# thresholds, portfolio weight targets, news dedup thresholds, etc.) --
# none of those are secrets, each already has a sane default, and each
# is documented as a comment at its own definition site
# (src/backtesting/config.py, src/market_intelligence/config.py,
# src/portfolio_intelligence/config.py, src/news_intelligence/config.py,
# src/market_data/ingestion/config.py). See docs/PRODUCTION_CONFIGURATION.md
# for the full picture of what is and isn't covered here.
#
# `API_KEY` and `TADAWUL_API_KEY` from an older revision of this file
# were audited out (Phase 13, P13.2): neither is read by any code path
# in this repository.

# ===========================
# Core
# ===========================
# development | staging | production. Production with an unset/default
# SECRET_KEY fails to boot -- see the Security section below.
BASEERA_ENV=development

# ===========================
# Database (PostgreSQL)
# ===========================
DATABASE_URL=postgresql://user:password@localhost:5432/baseera_db

# ===========================
# Redis
# ===========================
# Preferred for any managed Redis provider (Railway, Render, Upstash,
# Redis Cloud, ElastiCache with AUTH) -- a single DSN, optionally
# "rediss://" for TLS. Takes priority over REDIS_HOST/REDIS_PORT/
# REDIS_PASSWORD below when set.
# REDIS_URL=rediss://:password@your-managed-redis-host:6380/0

# Fallback when REDIS_URL is unset -- local/unauthenticated Redis by
# default (matches docker-compose.yml's local "redis" service).
REDIS_HOST=localhost
REDIS_PORT=6379
# REDIS_PASSWORD=

# ===========================
# Security -- REQUIRED before BASEERA_ENV=production
# ===========================
# No safe default exists. Generate with:
#   python3 -c "import secrets; print(secrets.token_urlsafe(64))"
# The app refuses to boot in production with this unset or left at the
# insecure development default -- see src/core/config/settings.py's
# `_reject_insecure_secret_in_production`. Rotating this invalidates
# every existing session (see docs/SECRET_ROTATION.md).
SECRET_KEY=your_secret_key_here

# Comma-separated frontend origins allowed to make cross-origin,
# credentialed requests (e.g. "https://app.baseerah.sa"). Empty by
# default -- CORS is not enabled at all until this is set (never a
# wildcard with allow_credentials=True).
# CORS_ALLOWED_ORIGINS=https://app.baseerah.sa

# Comma-separated Host headers this app will answer to (Starlette's
# TrustedHostMiddleware -- defends against Host header injection).
# Empty by default (not enforced) -- REQUIRED before production
# sign-off, set to your actual API domain(s)/platform-generated host.
# TRUSTED_HOSTS=api.baseerah.sa

# ===========================
# Auth token lifetimes
# ===========================
# ACCESS_TOKEN_EXPIRE_MINUTES=15
# REFRESH_TOKEN_EXPIRE_DAYS=30
# EMAIL_VERIFICATION_TOKEN_EXPIRE_HOURS=24
# PASSWORD_RESET_TOKEN_EXPIRE_HOURS=1

# ===========================
# Data retention (src/auth/retention_cleanup_service.py, Phase 13 P13.6)
# ===========================
# How long a revoked/expired UserSession row, or an expired email-
# verification/password-reset token, is kept before permanent deletion
# by scripts/run_retention_cleanup.py. Engineering defaults, not a
# confirmed legal retention requirement for any jurisdiction -- see
# docs/ACCOUNT_DELETION_AND_EXPORT.md.
# SESSION_RETENTION_DAYS=30
# TOKEN_RETENTION_DAYS=7

# ===========================
# Subscriptions
# ===========================
# TRIAL_LENGTH_DAYS=14

# ===========================
# Billing (no real payment gateway is wired -- src/billing/)
# ===========================
# The only implementation today is a non-production, explicitly-labeled
# no-op provider (src/billing/providers/noop_payment_provider.py) --
# see docs/PAYMENT_PROVIDER_INTEGRATION.md for what a real Saudi
# payment provider integration still needs.
# BILLING_NOOP_AUTO_APPROVE=true

# ===========================
# Rate limiting
# ===========================
# RATE_LIMIT_ENABLED=true

# ===========================
# Logging / error monitoring
# ===========================
# LOG_LEVEL=INFO
# LOG_DIR=/var/log/basirah

# Sentry DSN -- opt-in only. Unset (the default) means no network call
# to Sentry is ever attempted, in dev, CI, or production.
# SENTRY_DSN=

# ===========================
# LLM Configuration (OpenAI -- News Intelligence entity/sentiment/impact analysis)
# ===========================
# Unset means the News Intelligence analyzer honestly reports
# "unavailable" rather than fabricating a classification -- never a
# silent fallback to fake output. See docs/NEWS_INTELLIGENCE.md.
OPENAI_API_KEY=your_openai_api_key_here
# NEWS_LLM_MODEL=gpt-4o-mini

# ===========================
# Saudi Market Data (SAHMK -- sahmk.sa, Tadawul-licensed)
# ===========================
# See docs/SAHMK_INTEGRATION.md for the verified endpoint/auth contract
# and docs/SAHMK_PRODUCTION_VALIDATION.md for the Phase 13 real-provider
# validation report. Never commit a real value here -- get a key from
# your own sahmk.sa account, never reuse a key that has appeared in a
# chat, screenshot, or any other message.
#
# Leave SAHMK_API_KEY unset to keep using DevMarketDataProvider
# (synthetic, honestly labeled data): src/market_data/provider_factory.py
# automatically uses the real SAHMK provider only when this key is set
# AND sahmk.sa is reachable, falling back to synthetic data otherwise --
# no other variable below needs to change to enable/disable live data.
SAHMK_API_KEY=your_sahmk_api_key_here
# SAHMK_BASE_URL defaults to SAHMK's own published base URL; override
# only for testing against a different host.
# SAHMK_BASE_URL=https://app.sahmk.sa/api/v1

# Force a specific provider instead of auto-detecting network access:
# "dev" (always synthetic) or "sahmk" (always attempt live, still
# falling back to "dev" if sahmk.sa is unreachable). Leave unset (or
# "auto") for the default automatic behavior described above.
# MARKET_DATA_PROVIDER=auto

# Shared, process-wide throttle applied to every SahmkClient instance.
# Defaults match the Starter plan's published limits -- override only
# if your plan differs.
# SAHMK_MAX_REQUESTS_PER_MINUTE=20
# SAHMK_MAX_REQUESTS_PER_DAY=

# ===========================
# Ingestion scheduler
# ===========================
# Disabled by default (secure/inert by default, same posture as
# SAHMK_API_KEY/CORS_ALLOWED_ORIGINS above).
# INGESTION_SCHEDULER_ENABLED=false
# MARKET_INTELLIGENCE_SCHEDULER_ENABLED=false

# Comma-separated Tadawul symbols to track. Leave unset for the
# built-in Starter-tier default set.
# INGESTION_SYMBOL_UNIVERSE=2222,1120,2010,1180,7010

# ===========================
# Process / server
# ===========================
# PORT=8000
# HOST=0.0.0.0
# WORKER_COUNT=2
