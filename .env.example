# ===========================
# منصة بصيرة - متغيرات البيئة
# ===========================
# انسخ هذا الملف إلى .env وعدّل القيم المناسبة
# لا ترفع ملف .env إلى Git أبداً

# البيئة (development | staging | production)
BASEERA_ENV=development

# ===========================
# LLM Configuration
# ===========================
OPENAI_API_KEY=your_openai_api_key_here
OPENAI_MODEL=gpt-4o

# ===========================
# Database
# ===========================
DATABASE_URL=postgresql://user:password@localhost:5432/baseera_db

# ===========================
# Security
# ===========================
SECRET_KEY=your_secret_key_here
API_KEY=your_api_key_here

# ===========================
# Saudi Market Data
# ===========================
# No licensed Tadawul data vendor was contracted as of M2.1 -- that gap
# is now closed by the SAHMK (sahmk.sa) integration below.
# TADAWUL_API_KEY has no provider behind it and is unused; kept only so
# an existing .env with this key set does not need to change.
TADAWUL_API_KEY=your_tadawul_api_key_here

# SAHMK (sahmk.sa) -- Tadawul-licensed Saudi market data API.
# See docs/SAHMK_INTEGRATION.md for the verified endpoint/auth contract.
# Leave SAHMK_API_KEY unset to keep using DevMarketDataProvider
# (synthetic data): src/market_data/provider_factory.py automatically
# uses the real SAHMK provider only when this key is set AND sahmk.sa is
# reachable, falling back to synthetic data otherwise -- no other
# variable below needs to change to enable/disable live data.
SAHMK_API_KEY=your_sahmk_api_key_here
# SAHMK_BASE_URL defaults to SAHMK's own published base URL; override
# only for testing against a different host.
# SAHMK_BASE_URL=https://app.sahmk.sa/api/v1

# Force a specific provider instead of auto-detecting network access:
# "dev" (always synthetic) or "sahmk" (always attempt live, still
# falling back to "dev" if sahmk.sa is unreachable). Leave unset (or
# "auto") for the default automatic behavior described above.
# MARKET_DATA_PROVIDER=auto

# ===========================
# API / Frontend
# ===========================
# Comma-separated list of allowed frontend origins for the
# GET /api/v1/stocks/* REST API (e.g. "http://localhost:3000").
# Deliberately empty (no cross-origin access) by default -- same
# secure-by-default posture as SAHMK_LIVE_DATA_ENABLED above: a
# frontend origin must be explicitly opted in.
# CORS_ALLOWED_ORIGINS=

# ===========================
# SAHMK API rate limiting
# ===========================
# Shared, process-wide throttle applied to every SahmkClient instance
# (SAHMK quota is per-API-key/account, not per client). Defaults match
# the Starter plan's published limits -- override only if your plan
# differs.
# SAHMK_MAX_REQUESTS_PER_MINUTE=20
# Leave unset for no daily cap.
# SAHMK_MAX_REQUESTS_PER_DAY=

# ===========================
# Ingestion scheduler
# ===========================
# Automatically keeps the database in sync with SAHMK: market symbols,
# historical OHLCV, company fundamentals, and dividends, each on its own
# recurring interval. Disabled by default (secure/inert by default, same
# posture as SAHMK_API_KEY/CORS_ALLOWED_ORIGINS above) -- enabling it
# with no SAHMK_API_KEY set is safe too, since it just ingests synthetic
# DevMarketDataProvider data on the same schedule.
# INGESTION_SCHEDULER_ENABLED=false

# Comma-separated Tadawul symbols to track. Leave unset for the built-in
# Starter-tier default set; set to an empty string to track nothing.
# INGESTION_SYMBOL_UNIVERSE=2222,1120,2010,1180,7010

# When true, the symbols job also pulls SAHMK's full company directory
# (one extra request) and merges it with INGESTION_SYMBOL_UNIVERSE,
# instead of only syncing the explicit list above.
# INGESTION_AUTO_DISCOVER_SYMBOLS=false

# How often each job re-runs, in seconds.
# INGESTION_SYMBOLS_INTERVAL_SECONDS=86400
# INGESTION_OHLCV_INTERVAL_SECONDS=3600
# INGESTION_FUNDAMENTALS_INTERVAL_SECONDS=604800
# INGESTION_DIVIDENDS_INTERVAL_SECONDS=86400

# How many days of history to backfill the first time a symbol has no
# bars yet; later runs only fetch the gap since the last stored bar.
# INGESTION_OHLCV_BACKFILL_DAYS=90

# "annual" or "quarterly".
# INGESTION_FUNDAMENTALS_PERIOD_TYPE=annual

# Job-level retry (a whole run failing outright, e.g. a DB blip) --
# distinct from SahmkClient's own per-HTTP-request retry.
# INGESTION_JOB_MAX_ATTEMPTS=3
# INGESTION_JOB_RETRY_BASE_DELAY_SECONDS=5
